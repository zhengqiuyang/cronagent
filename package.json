{
  "name": "cronagent",
  "version": "0.1.0",
  "description": "cron for AI coding agents: run headless CLI agents (claude -p, opencode, aider, or any shell command) on a schedule, archive every run, generate an HTML report.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cronagent": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "demo",
    "cronagent.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "demo": "node demo/fake-agent.js"
  },
  "keywords": [
    "cron",
    "scheduler",
    "ai",
    "coding-agent",
    "claude-code",
    "opencode",
    "aider",
    "automation",
    "cli"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
